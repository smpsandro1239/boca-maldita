# ===== Servidor API =====
# Porta onde a API Express arranca (a Vercel define PORT automaticamente)
PORT=3001

# Caminho do ficheiro SQLite local (apenas em ambiente local/dev)
DB_PATH=data/boca-maldita.db

# URL pública da aplicação (usada para CORS)
APP_URL="http://localhost:3000"

# ===== Painel de Administração (substituir imagens) =====
# Token exigido em PUT/DELETE /api/admin/assets. Sem valor, a gravação
# permanente está desativada (o painel avisa). Defina sempre em produção,
# na Vercel (Settings > Environment Variables).
ADMIN_TOKEN=""

# ===== Email de confirmação de reservas (SMTP) =====
# Se SMTP_HOST estiver vazio, a confirmação é ignorada (reserva continua a ser gravada).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Boca Maldita <reservas@bocamaldita.pt>"

# ===== Base de dados persistente em produção (Turso) =====
# Se TURSO_URL e TURSO_AUTH_TOKEN estiverem definidos, o servidor usa o Turso
# (SQLite alojado, necessário na Vercel para persistência). Caso contrário,
# cai para SQLite local (apenas útil em dev).
# Criar base: https://console.turso.io -> "turso db create boca-maldita"
TURSO_URL=""
TURSO_AUTH_TOKEN=""
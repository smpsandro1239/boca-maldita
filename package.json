{
  "name": "boca-maldita",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Website oficial do Boca Maldita — Fine Dining & Grill, Vila de Prado.",
  "scripts": {
    "dev": "concurrently -k -s first -n api,web -c auto \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --import tsx --disable-warning=ExperimentalWarning --watch server/index.ts",
    "build": "node scripts/build-api.mjs && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "start": "node --import tsx --disable-warning=ExperimentalWarning server/index.ts",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "nodemailer": "^10.0.10",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.1"
  }
}
